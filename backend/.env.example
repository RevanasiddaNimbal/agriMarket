#profile configuration
SPRING_PROFILES_ACTIVE=dev

# Database configurations
DB_NAME=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password
DB_URL=your database_url
DB_PORT=your database_port

# frontend configuration
FRONTEND_URL=your frontend_url
FRONTEND_OAUTH2_SUCCESS_URL=your frontend_oauth2_success_url

# Brevo email configuration
BREVO_API_KEY= your brevo_api_key
BREVO_SENDER_EMAIL=your sender_email
BREVO_SENDER_NAME=your sender_name
BREVO_URL=your brevo_url

# OAuth configuration
GITHUB_CLIENT_ID= github client_id
GITHUB_CLIENT_SECRET=github client_secret
GOOGLE_CLIENT_ID=google client_id
GOOGLE_CLIENT_SECRET=google client_secret

#Admin init configuration
INITIAL_ADMIN_EMAIL=your admin_email
INITIAL_ADMIN_PASSWORD=your admin_password
INITIAL_ADMIN_PHONE=your admin_phone

# CORS configuration (example for now)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

#secure keys configuration (production)
JWT_PRIVATE_KEY_PATH=path of private key file
JWT_PUBLIC_KEY_PATH=path of public key file

